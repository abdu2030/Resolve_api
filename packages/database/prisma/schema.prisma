generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("tenant_status")
}

enum EntityType {
  PERSON
  COMPANY

  @@map("entity_type")
}

enum EntityStatus {
  ACTIVE
  MERGED

  @@map("entity_status")
}

enum EntityOperationType {
  MERGE
  SPLIT
  UNMERGE

  @@map("entity_operation_type")
}

enum MatchDecision {
  AUTO_MATCH
  REVIEW
  NO_MATCH

  @@map("match_decision")
}

enum CanonicalSelectionRule {
  ONLY_CANDIDATE
  SOURCE_PRIORITY
  COMPLETENESS
  RECENCY
  STABLE_TIE_BREAK

  @@map("canonical_selection_rule")
}

enum CanonicalTriggerOperation {
  ENTITY_CREATED
  RECORD_LINKED
  RECORD_UPDATED
  LEGACY_BACKFILL
  MERGE
  SPLIT

  @@map("canonical_trigger_operation")
}

enum ReviewCaseStatus {
  OPEN
  RESOLVED

  @@map("review_case_status")
}

model Tenant {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String                   @db.VarChar(120)
  status               TenantStatus             @default(ACTIVE)
  plan                 String                   @default("free") @db.VarChar(50)
  planMetadata         Json                     @default("{}") @map("plan_metadata")
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  apiKeys              ApiKey[]
  sourceSystems        SourceSystem[]
  sourceRecords        SourceRecord[]
  entities             Entity[]
  entityRecordLinks    EntityRecordLink[]
  matchFeatures        MatchFeature[]
  reviewCases          ReviewCase[]
  sourceRecordVersions SourceRecordVersion[]
  idempotencyRequests  IdempotencyRequest[]
  fieldProvenance      EntityFieldProvenance[]
  canonicalVersions    EntityCanonicalVersion[]
  entityOperations     EntityOperation[]

  @@map("tenants")
}

model ApiKey {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  name             String            @db.VarChar(120)
  prefix           String            @db.VarChar(32)
  keyHash          String            @unique(map: "api_keys_key_hash_key") @map("key_hash") @db.VarChar(255)
  scopes           String[]          @default([])
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt        DateTime?         @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt       DateTime?         @map("last_used_at") @db.Timestamptz(3)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "api_keys_tenant_fkey")
  entityOperations EntityOperation[]

  @@unique([tenantId, id], map: "api_keys_tenant_id_key")
  @@index([tenantId, revokedAt], map: "api_keys_tenant_revoked_idx")
  @@index([prefix], map: "api_keys_prefix_idx")
  @@map("api_keys")
}

model SourceSystem {
  id                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String                  @map("tenant_id") @db.Uuid
  name                     String                  @db.VarChar(120)
  type                     String                  @db.VarChar(50)
  priority                 Int                     @default(100)
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "source_systems_tenant_fkey")
  sourceRecords            SourceRecord[]
  canonicalFieldProvenance EntityFieldProvenance[]

  @@unique([tenantId, name], map: "source_systems_tenant_name_key")
  @@unique([tenantId, id], map: "source_systems_tenant_id_key")
  @@map("source_systems")
}

model SourceRecord {
  id                         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                   String                   @map("tenant_id") @db.Uuid
  sourceSystemId             String                   @map("source_system_id") @db.Uuid
  externalId                 String                   @map("external_id") @db.VarChar(255)
  entityType                 EntityType               @map("entity_type")
  rawPayload                 Json                     @map("raw_payload")
  rawPayloadHash             String?                  @map("raw_payload_hash") @db.Char(64)
  currentVersion             Int                      @default(1) @map("current_version")
  normalizedPayload          Json?                    @map("normalized_payload")
  normalizationVersion       String?                  @map("normalization_version") @db.VarChar(50)
  normalizedEmail            String?                  @map("normalized_email") @db.VarChar(320)
  normalizedPhone            String?                  @map("normalized_phone") @db.VarChar(32)
  companyDomain              String?                  @map("company_domain") @db.VarChar(253)
  normalizedNamePrefix       String?                  @map("normalized_name_prefix") @db.VarChar(64)
  createdAt                  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "source_records_tenant_fkey")
  sourceSystem               SourceSystem             @relation(fields: [tenantId, sourceSystemId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "source_records_tenant_source_system_fkey")
  entityRecordLink           EntityRecordLink?
  matchFeaturesAsSource      MatchFeature[]           @relation("MatchFeatureSourceRecord")
  matchFeaturesAsCandidate   MatchFeature[]           @relation("MatchFeatureCandidateRecord")
  reviewCasesAsSource        ReviewCase[]             @relation("ReviewCaseSourceRecord")
  reviewCasesAsCandidate     ReviewCase[]             @relation("ReviewCaseCandidateRecord")
  versions                   SourceRecordVersion[]
  fieldProvenance            EntityFieldProvenance[]
  triggeredCanonicalVersions EntityCanonicalVersion[]

  @@unique([tenantId, id], map: "source_records_tenant_id_key")
  @@unique([tenantId, sourceSystemId, externalId], map: "source_records_tenant_source_external_key")
  @@index([tenantId, normalizedEmail], map: "source_records_tenant_normalized_email_idx")
  @@index([tenantId, normalizedPhone], map: "source_records_tenant_normalized_phone_idx")
  @@index([tenantId, companyDomain], map: "source_records_tenant_company_domain_idx")
  @@index([tenantId, entityType, normalizedNamePrefix], map: "source_records_tenant_type_name_prefix_idx")
  @@map("source_records")
}

model SourceRecordVersion {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  sourceRecordId String       @map("source_record_id") @db.Uuid
  version        Int
  rawPayload     Json         @map("raw_payload")
  payloadHash    String       @map("payload_hash") @db.Char(64)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "source_record_versions_tenant_fkey")
  sourceRecord   SourceRecord @relation(fields: [tenantId, sourceRecordId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "source_record_versions_tenant_source_record_fkey")

  @@unique([tenantId, sourceRecordId, version], map: "source_record_versions_tenant_record_version_key")
  @@map("source_record_versions")
}

model IdempotencyRequest {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  key            String   @db.VarChar(255)
  operation      String   @db.VarChar(100)
  requestHash    String   @map("request_hash") @db.Char(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "idempotency_requests_tenant_fkey")

  @@unique([tenantId, key], map: "idempotency_requests_tenant_key_key")
  @@index([tenantId, createdAt], map: "idempotency_requests_tenant_created_idx")
  @@map("idempotency_requests")
}

model Entity {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                   @map("tenant_id") @db.Uuid
  entityType         EntityType               @map("entity_type")
  status             EntityStatus             @default(ACTIVE)
  mergedIntoEntityId String?                  @map("merged_into_entity_id") @db.Uuid
  canonicalData      Json                     @default("{}") @map("canonical_data")
  canonicalVersion   Int                      @default(0) @map("canonical_version")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "entities_tenant_fkey")
  entityRecordLinks  EntityRecordLink[]
  matchFeatures      MatchFeature[]
  reviewCases        ReviewCase[]
  fieldProvenance    EntityFieldProvenance[]
  canonicalVersions  EntityCanonicalVersion[]
  mergedIntoEntity   Entity?                  @relation("EntityMergedInto", fields: [tenantId, mergedIntoEntityId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "entities_tenant_merged_into_fkey")
  mergedEntities     Entity[]                 @relation("EntityMergedInto")
  operationsAsSource EntityOperation[]        @relation("EntityOperationSource")
  operationsAsTarget EntityOperation[]        @relation("EntityOperationTarget")

  @@unique([tenantId, id], map: "entities_tenant_id_key")
  @@index([tenantId, entityType], map: "entities_tenant_entity_type_idx")
  @@map("entities")
}

model EntityFieldProvenance {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String                 @map("tenant_id") @db.Uuid
  entityId                String                 @map("entity_id") @db.Uuid
  fieldPath               String                 @map("field_path") @db.VarChar(100)
  canonicalValue          Json                   @map("canonical_value")
  rawValue                Json                   @map("raw_value")
  sourceRecordId          String                 @map("source_record_id") @db.Uuid
  sourceSystemId          String                 @map("source_system_id") @db.Uuid
  sourceExternalId        String                 @map("source_external_id") @db.VarChar(255)
  sourcePriority          Int                    @map("source_priority")
  selectionRule           CanonicalSelectionRule @map("selection_rule")
  completenessScore       Int                    @map("completeness_score")
  observedAt              DateTime               @map("observed_at") @db.Timestamptz(3)
  normalizationVersion    String                 @map("normalization_version") @db.VarChar(50)
  canonicalizationVersion String                 @map("canonicalization_version") @db.VarChar(50)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "entity_field_provenance_tenant_fkey")
  entity                  Entity                 @relation(fields: [tenantId, entityId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "entity_field_provenance_tenant_entity_fkey")
  sourceRecord            SourceRecord           @relation(fields: [tenantId, sourceRecordId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "entity_field_provenance_tenant_source_record_fkey")
  sourceSystem            SourceSystem           @relation(fields: [tenantId, sourceSystemId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "entity_field_provenance_tenant_source_system_fkey")

  @@unique([tenantId, entityId, fieldPath], map: "entity_field_provenance_tenant_entity_field_key")
  @@index([tenantId, entityId], map: "entity_field_provenance_tenant_entity_idx")
  @@map("entity_field_provenance")
}

model EntityCanonicalVersion {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String                    @map("tenant_id") @db.Uuid
  entityId                String                    @map("entity_id") @db.Uuid
  version                 Int
  canonicalData           Json                      @map("canonical_data")
  provenance              Json
  triggerSourceRecordId   String?                   @map("trigger_source_record_id") @db.Uuid
  triggerOperation        CanonicalTriggerOperation @map("trigger_operation")
  entityOperationId       String?                   @map("entity_operation_id") @db.Uuid
  canonicalizationVersion String                    @map("canonicalization_version") @db.VarChar(50)
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant                  Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "entity_canonical_versions_tenant_fkey")
  entity                  Entity                    @relation(fields: [tenantId, entityId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "entity_canonical_versions_tenant_entity_fkey")
  triggerSourceRecord     SourceRecord?             @relation(fields: [tenantId, triggerSourceRecordId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "entity_canonical_versions_tenant_trigger_record_fkey")
  entityOperation         EntityOperation?          @relation(fields: [tenantId, entityOperationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "entity_canonical_versions_tenant_operation_fkey")

  @@unique([tenantId, entityId, version], map: "entity_canonical_versions_tenant_entity_version_key")
  @@index([tenantId, entityId, version(sort: Desc)], map: "entity_canonical_versions_tenant_entity_version_idx")
  @@map("entity_canonical_versions")
}

model EntityRecordLink {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String           @map("tenant_id") @db.Uuid
  entityId              String           @map("entity_id") @db.Uuid
  sourceRecordId        String           @map("source_record_id") @db.Uuid
  score                 Decimal          @db.Decimal(5, 4)
  decision              MatchDecision
  algorithmVersion      String           @map("algorithm_version") @db.VarChar(50)
  explanation           Json             @default("{\"candidate_count\":0,\"features\":{},\"contradictions\":[]}")
  lastEntityOperationId String?          @map("last_entity_operation_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "entity_record_links_tenant_fkey")
  entity                Entity           @relation(fields: [tenantId, entityId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "entity_record_links_tenant_entity_fkey")
  sourceRecord          SourceRecord     @relation(fields: [tenantId, sourceRecordId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "entity_record_links_tenant_source_record_fkey")
  lastEntityOperation   EntityOperation? @relation(fields: [tenantId, lastEntityOperationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "entity_record_links_tenant_last_operation_fkey")

  @@unique([tenantId, sourceRecordId], map: "entity_record_links_tenant_record_key")
  @@index([tenantId, entityId], map: "entity_record_links_tenant_entity_idx")
  @@map("entity_record_links")
}

model EntityOperation {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String                   @map("tenant_id") @db.Uuid
  type                EntityOperationType
  operationVersion    String                   @default("entity-operations-v1") @map("operation_version") @db.VarChar(50)
  sourceEntityId      String                   @map("source_entity_id") @db.Uuid
  targetEntityId      String                   @map("target_entity_id") @db.Uuid
  recordIds           Json                     @map("record_ids")
  reason              String                   @db.VarChar(500)
  actorApiKeyId       String                   @map("actor_api_key_id") @db.Uuid
  sourceVersionBefore Int                      @map("source_version_before")
  sourceVersionAfter  Int                      @map("source_version_after")
  targetVersionBefore Int                      @map("target_version_before")
  targetVersionAfter  Int                      @map("target_version_after")
  reversedOperationId String?                  @map("reversed_operation_id") @db.Uuid
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "entity_operations_tenant_fkey")
  sourceEntity        Entity                   @relation("EntityOperationSource", fields: [tenantId, sourceEntityId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "entity_operations_tenant_source_fkey")
  targetEntity        Entity                   @relation("EntityOperationTarget", fields: [tenantId, targetEntityId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "entity_operations_tenant_target_fkey")
  actorApiKey         ApiKey                   @relation(fields: [tenantId, actorApiKeyId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "entity_operations_tenant_actor_fkey")
  reversedOperation   EntityOperation?         @relation("EntityOperationReversal", fields: [tenantId, reversedOperationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "entity_operations_tenant_reversed_operation_fkey")
  reversal            EntityOperation?         @relation("EntityOperationReversal")
  entityRecordLinks   EntityRecordLink[]
  canonicalVersions   EntityCanonicalVersion[]

  @@unique([tenantId, id], map: "entity_operations_tenant_id_key")
  @@unique([tenantId, reversedOperationId], map: "entity_operations_tenant_reversed_operation_key")
  @@map("entity_operations")
}

model MatchFeature {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String        @map("tenant_id") @db.Uuid
  sourceRecordId          String        @map("source_record_id") @db.Uuid
  candidateSourceRecordId String        @map("candidate_source_record_id") @db.Uuid
  candidateEntityId       String        @map("candidate_entity_id") @db.Uuid
  featureVersion          String        @map("feature_version") @db.VarChar(50)
  algorithmVersion        String        @map("algorithm_version") @db.VarChar(50)
  scoreInputs             Json          @map("score_inputs")
  explanation             Json
  score                   Decimal       @db.Decimal(5, 4)
  decision                MatchDecision
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant                  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "match_features_tenant_fkey")
  sourceRecord            SourceRecord  @relation("MatchFeatureSourceRecord", fields: [tenantId, sourceRecordId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "match_features_tenant_source_record_fkey")
  candidateSourceRecord   SourceRecord  @relation("MatchFeatureCandidateRecord", fields: [tenantId, candidateSourceRecordId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "match_features_tenant_candidate_record_fkey")
  candidateEntity         Entity        @relation(fields: [tenantId, candidateEntityId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "match_features_tenant_candidate_entity_fkey")
  reviewCase              ReviewCase?

  @@unique([tenantId, id, sourceRecordId, candidateSourceRecordId, candidateEntityId], map: "match_features_review_identity_key")
  @@index([tenantId, sourceRecordId], map: "match_features_tenant_source_record_idx")
  @@index([tenantId, candidateSourceRecordId], map: "match_features_tenant_candidate_record_idx")
  @@index([tenantId, candidateEntityId], map: "match_features_tenant_candidate_entity_idx")
  @@map("match_features")
}

model ReviewCase {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String           @map("tenant_id") @db.Uuid
  sourceRecordId          String           @map("source_record_id") @db.Uuid
  candidateEntityId       String           @map("candidate_entity_id") @db.Uuid
  candidateSourceRecordId String           @map("candidate_source_record_id") @db.Uuid
  matchFeatureId          String           @map("match_feature_id") @db.Uuid
  status                  ReviewCaseStatus @default(OPEN)
  score                   Decimal          @db.Decimal(5, 4)
  explanation             Json
  algorithmVersion        String           @map("algorithm_version") @db.VarChar(50)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "review_cases_tenant_fkey")
  sourceRecord            SourceRecord     @relation("ReviewCaseSourceRecord", fields: [tenantId, sourceRecordId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "review_cases_tenant_source_record_fkey")
  candidateSourceRecord   SourceRecord     @relation("ReviewCaseCandidateRecord", fields: [tenantId, candidateSourceRecordId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "review_cases_tenant_candidate_record_fkey")
  candidateEntity         Entity           @relation(fields: [tenantId, candidateEntityId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "review_cases_tenant_candidate_entity_fkey")
  matchFeature            MatchFeature     @relation(fields: [tenantId, matchFeatureId, sourceRecordId, candidateSourceRecordId, candidateEntityId], references: [tenantId, id, sourceRecordId, candidateSourceRecordId, candidateEntityId], onDelete: Restrict, onUpdate: NoAction, map: "review_cases_selected_match_feature_fkey")

  @@unique([tenantId, sourceRecordId], map: "review_cases_tenant_source_record_key")
  @@unique([tenantId, matchFeatureId, sourceRecordId, candidateSourceRecordId, candidateEntityId], map: "review_cases_selected_match_feature_key")
  @@index([tenantId, status, createdAt], map: "review_cases_tenant_status_created_idx")
  @@index([tenantId, candidateEntityId], map: "review_cases_tenant_candidate_entity_idx")
  @@map("review_cases")
}
