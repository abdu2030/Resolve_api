{
  "name": "resolve-api",
  "version": "0.1.0",
  "private": true,
  "description": "Explainable, reversible entity resolution for person and company records.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build -w @resolve/contracts && npm run build -w @resolve/config && npm run build -w @resolve/database && npm run build -w @resolve/api && npm run build -w @resolve/worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "prisma:generate": "npm run prisma:generate -w @resolve/database",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy -w @resolve/database",
    "prisma:migrate:dev": "npm run prisma:migrate:dev -w @resolve/database --",
    "prisma:validate": "npm run prisma:validate -w @resolve/database",
    "start:api": "npm run start -w @resolve/api",
    "start:worker": "npm run start -w @resolve/worker",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand",
    "typecheck": "npm run build -w @resolve/contracts && npm run build -w @resolve/config && npm run build -w @resolve/database && npm run typecheck -w @resolve/api && npm run typecheck -w @resolve/worker"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.3",
    "@types/supertest": "^6.0.3",
    "ci-info": "^3.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "^29.16.6",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "type": "module"
}
