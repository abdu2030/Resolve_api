NODE_ENV=development
API_PORT=3000
BLOCKING_MAX_CANDIDATES=100
BATCH_QUEUE_PREFIX=resolve
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_KEY_MAX=600
RATE_LIMIT_TENANT_MAX=3000
RATE_LIMIT_BATCH_KEY_MAX=20
RATE_LIMIT_BATCH_TENANT_MAX=100
METRICS_TOKEN=
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BASE_MS=1000
DATABASE_URL=postgresql://resolve:resolve@localhost:5432/resolve?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REQUEST_BODY_LIMIT=1mb
POSTGRES_DB=resolve
POSTGRES_PORT=5432
POSTGRES_USER=resolve
POSTGRES_PASSWORD=resolve
